# =============================================================================
# Configuración del backend B2B · copia este archivo a .env y ajusta secretos
# =============================================================================

# --- PostgreSQL (owner; usado por Flyway y docker-compose) -------------------
POSTGRES_DB=docswarm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Rol de aplicación (RLS) -------------------------------------------------
# La app conecta con ESTE rol (NOSUPERUSER NOBYPASSRLS). Debe coincidir con la
# contraseña asignada a docswarm_app (ver V1; cámbiala en producción con
#   ALTER ROLE docswarm_app PASSWORD '...';).
APP_DB_USER=docswarm_app
APP_DB_PASSWORD=change_me_in_env
# Conexión directa de la app (compose la sobreescribe con host=postgres):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docswarm
DB_USER=docswarm_app
DB_PASSWORD=change_me_in_env
# Pon a 1 SOLO para procesos de fondo/backfill que deben saltarse RLS (worker).
DB_ALLOW_ADMIN_ROLE=0
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- MinIO / S3 --------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docswarm-docs
MINIO_SECURE=0

# --- Ollama (LLM local) ------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Timeout por llamada LLM (s). Si Ollama no responde, cae a Gemini.
LLM_TIMEOUT=60
# Proveedor por defecto: auto | ollama | gemini | stub
LLM_PREFER=auto

# --- Gemini (fallback / motor del chatbot ACP) -------------------------------
# Pega aquí tu API key de Google AI Studio. Si está vacía, se usa Ollama/Stub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings (BGE-M3, 1024-dim) ------------------------------------------
# 1 = usa el modelo real (FlagEmbedding/sentence-transformers, pesado);
# 0 = usa un embedder stub determinista (sin dependencias, para dev/CI).
EMBEDDINGS_REAL=0
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIM=1024

# --- API / Auth --------------------------------------------------------------
API_PORT=8000
JWT_SECRET=cambia-esta-clave-larga-y-aleatoria
JWT_EXPIRE_MINUTES=480

# --- Notifier (microservicio WhatsApp/Gmail + firma) -------------------------
NOTIFIER_PORT=8010
# Clave de servicio M2M (header X-API-Key) que usa el repo externo / notifier.
SERVICE_API_KEY=cambia-esta-service-key
# Crear notificaciones automáticamente al registrar un cambio + canales.
NOTIF_AUTO=1
NOTIF_CANALES=WHATSAPP,GMAIL
# Credenciales de canal (vacías → modo dry-run, simula entrega sin enviar).
# --- WhatsApp por QR (gateway Baileys, vía no oficial · demo) ---
# Puerto local del gateway; vincula la cuenta en http://localhost:<puerto>/qr
WA_GATEWAY_PORT=3010
# URL interna que usa el notifier para enviar (red Docker). Vacío → dry-run/Cloud API.
WA_GATEWAY_URL=http://wa-gateway:3000
# Prefijo de país para números locales (57 = Colombia).
WA_DEFAULT_COUNTRY_CODE=57
# --- WhatsApp Cloud API oficial (alternativa, sin QR) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- pgAdmin (perfil tools) --------------------------------------------------
PGADMIN_EMAIL=admin@docswarm.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Cloudflare Tunnel: directorio local con config.yml + <tunnel-id>.json (NUNCA dentro del repo).
# Crear con: cloudflared tunnel login && cloudflared tunnel create <nombre>
CLOUDFLARED_DIR=C:/Users/<tu-usuario>/.cloudflared
